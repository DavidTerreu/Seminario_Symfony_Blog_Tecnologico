<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Blog Tecnológico{% endblock %}</title>
        {% block stylesheets %}
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body { font-family: Arial, sans-serif; line-height: 1.6; }
                header { background: #333; color: #fff; padding: 1rem; text-align: center; }
                nav { background: #555; padding: 0.5rem; }
                nav a { color: #fff; text-decoration: none; padding: 0.5rem 1rem; display: inline-block; }
                nav a:hover { background: #777; }
                main { min-height: 70vh; padding: 2rem; }
                footer { background: #333; color: #fff; text-align: center; padding: 1rem; margin-top: 2rem; }
            </style>
        {% endblock %}
    </head>
    <body>
        <header>
            <h1>Blog Tecnológico</h1>
        </header>

        <nav>
            <a href="{{ path('app_blog') }}">Inicio</a>
        </nav>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer>
            <p>&copy; {{ 'now'|date('Y') }} Blog Tecnológico. Todos los derechos reservados.</p>
        </footer>

        {% block javascripts %}{% endblock %}
    </body>
</html>
