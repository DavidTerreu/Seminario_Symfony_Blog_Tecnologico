{% extends 'base.html.twig' %}

{% block title %}Ejercicio prueba Symfony{% endblock %}

{% block body %}
    <div class="container">
        <h1>Últimos Posts</h1>

        {% for post in posts %}
            <article class="post">
                <h2>{{ post.title }}</h2>
                <p class="meta">
                    Publicado el {{ post.publishedAt|date('d/m/Y H:i') }}
                    por {{ post.author }}
                </p>
                <p>{{ post.content|slice(0, 200) }}...</p>
                <a href="{{ path('app_post_show', {id: post.id}) }}">Leer más</a>
            </article>
            <hr>
        {% else %}
            <p>No hay posts disponibles.</p>
        {% endfor %}
    </div>

<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>
{% endblock %}
