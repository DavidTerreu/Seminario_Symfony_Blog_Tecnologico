{% extends 'base.html.twig' %}

{% block title %}{{ post.title }}{% endblock %}

{% block body %}
    <div class="container">
        <article>
            <h1>{{ post.title }}</h1>
            <p class="meta">
                Publicado el {{ post.publishedAt|date('d/m/Y H:i') }}
                por {{ post.author }}
            </p>
            <div class="content">
                {{ post.content|nl2br }}
            </div>
            <a href="{{ path('app_blog') }}">← Volver al inicio</a>
        </article>
    </div>
{% endblock %}
